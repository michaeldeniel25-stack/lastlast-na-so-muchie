# Copy this file to .env for local development and fill in private values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schooldocs
PGSSL=false
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=registrar@example.edu
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
